TEXT -944 136 Left 2 ;sawtooth
TEXT 272 -608 Left 2 !.include MyComparator.sub
TEXT 272 -560 Left 2 !.param t0=1m
TEXT 272 -536 Left 2 !.tran 0 {t0+5/Freq} {t0} 0.1u
TEXT 72 296 Left 2 !.step dec param Freq 100 300k 10
TEXT 856 280 Left 2 !.save V(out) V(in)
TEXT 856 304 Left 2 !.option numdgt=15 ; double precision for data\n.option nomarch   ; do not plot marching waveforms
TEXT 80 376 Left 2 !.measure Aavg     avg    V(out)                              ;average output voltage\n.measure Bavg     avg    V(in)                               ;average input signal  \n.measure Are      avg    2*(V(out))-Aavg)*cos(360*Freq*time) ;A real part\n.measure Aim      avg    2*(V(out))-Aavg)*sin(360*Freq*time) ;A imag part\n.measure Bre      avg    2*(V(in))-Bavg)*cos(360*Freq*time)  ;B real part\n.measure Bim      avg    2*(V(in))-Bavg)*sin(360*Freq*time)  ;B imag part\n.measure Amag     param  hypot(Are,Aim)                      ;A magnitude \n.measure Bmag     param  hypot(Bre,Bim)                      ;B magnitude\n.measure Aphi     param  atan2(Aim,Are)                      ;A phase\n.measure Bphi     param  atan2(Bim,Bre)                      ;B phase\n.measure GainMag  param  20*log10(Amag/Bmag)                 ;Gain magnitude\n.measure GainPhi  param  180-(Aphi-Bphi)                     ;Gain phase
